{
  "manifest_version": 3,
  "name": "ChatGPT Thread Export",
  "version": "1.1.0",
  "description": "Export the open ChatGPT conversation or share link via the official conversation API (full thread, including first and last messages).",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Export ChatGPT thread",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "chatgpt-thread-export@hinesai",
      "strict_min_version": "121.0"
    }
  }
}
